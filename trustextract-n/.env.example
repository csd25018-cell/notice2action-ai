# TrustExtract-N Environment Configuration Template
# Copy this file to .env and adjust variables if needed.

# Model & Pretrained Weights
MODEL_NAME=google/muril-base-cased
MODEL_PATH=models/trustextract
BASELINE_MODEL_PATH=output/baseline_model
CALIBRATION_FILE=models/trustextract/calibration.json

# Storage & Directory Paths
DATA_PATH=data
UPLOAD_PATH=data/uploads
CACHE_PATH=.cache

# Device Selection (auto | cuda | mps | cpu)
DEVICE=auto

# Server & Application Settings
APP_HOST=0.0.0.0
APP_PORT=8501

# Logging & Debugging
LOG_LEVEL=INFO

# Field Threshold Overrides (Optional)
THRESHOLD_LAST_DATE=0.85
THRESHOLD_AUTHORITY=0.80
THRESHOLD_TITLE=0.75
THRESHOLD_ELIGIBILITY=0.75
THRESHOLD_DOCUMENT=0.75
THRESHOLD_NOTICE_NUMBER=0.75
THRESHOLD_CONTACT=0.70
THRESHOLD_AUDIENCE=0.70
